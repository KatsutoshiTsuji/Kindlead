#. Add-on summary, usually the user-visible name of the add-on.
msgid "Kindlead - Accessible Kindle Reader"
msgstr "Kindlead - Kindle 無障礙電子書閱讀器"

#. Add-on description
msgid "Automatically converts Kindle for PC books into fully accessible HTML documents with heading hierarchy and table of contents using Google Gemini AI."
msgstr "利用 Google Gemini 視覺 AI，將 Kindle for PC 中開啟的電子書自動轉換為包含標題層級與目錄連結的完全無障礙 HTML 文件。"

msgid "Kindlead"
msgstr "Kindlead"

msgid "Gemini API Key (&K):"
msgstr "Gemini API 金鑰 (&K):"

msgid "Open Gemini API Key page in browser (&G)"
msgstr "在瀏覽器中開啟 Gemini API 金鑰取得頁面 (&G)"

msgid "Paste from clipboard (&V)"
msgstr "從剪貼簿貼上 (&V)"

msgid "Output folder (&O):"
msgstr "輸出資料夾 (&O):"

msgid "Browse output folder (&B)..."
msgstr "瀏覽輸出資料夾 (&B)..."

msgid "Page turn wait (seconds) (&W):"
msgstr "翻頁等待時間（秒）(&W):"

msgid "Maximum pages to capture (&M):"
msgstr "擷取最大頁數上限 (&M):"

msgid "Python executable path (auto-detected if blank) (&P):"
msgstr "Python 執行路徑（留空則自動偵測）(&P):"

msgid "Opened Google AI Studio API key page in browser. Copy your key, then click Paste."
msgstr "已在瀏覽器中開啟 Google AI Studio API 金鑰頁面。建立並複製金鑰後，點擊「貼上」按鈕。"

msgid "Pasted API key from clipboard."
msgstr "已從剪貼簿貼上 API 金鑰。"

msgid "No text found in clipboard."
msgstr "剪貼簿中未找到文字。"

msgid "Select output folder"
msgstr "請選擇輸出資料夾"

msgid "Output folder set to {path}"
msgstr "輸出資料夾已設定為 {path}"

msgid "Kindlead - Kindle Book Structured Capture"
msgstr "Kindlead - Kindle 電子書結構化擷取"

msgid ""
"[Important Checklist Before Starting]\n"
"Open the target book in Kindle for PC and display the beginning (cover / page 1).\n\n"
"● Once started, Kindle will automatically turn pages in full screen.\n"
"  Please do not touch the keyboard or mouse for a few minutes until completion.\n"
"● Progress is signaled with beeps (Page capture: 440Hz / AI analysis: 554Hz).\n"
"● Upon completion, a chime plays, and the structured HTML with TOC links opens in your browser.\n"
"● To cancel midway, run Kindlead from the NVDA menu again to safely stop."
msgstr ""
"【開始前的確認事項】\n"
"請在 Kindle for PC 中開啟欲閱讀的書籍，並確保顯示在【封面（第一頁）】後再開始。\n\n"
"● 開始後，Kindle 將在全螢幕下自動翻頁擷取。\n"
"  在處理完成前的數分鐘內，請勿觸碰鍵盤或滑鼠。\n"
"● 處理進度將透過嗶聲提示（頁面擷取: 440Hz / AI 分析完成: 554Hz）。\n"
"● 完成後將播放上升和弦音，並在瀏覽器中自動開啟包含目錄跳轉連結的結構化 HTML 電子書。\n"
"● 若需中途停止，只需再次從 NVDA 功能表執行 Kindlead 即可安全中止。"

msgid "Reading direction (&D)"
msgstr "書籍排版與翻頁方向 (&D)"

msgid "Auto detect (recommended)"
msgstr "自動偵測（推薦）"

msgid "Vertical (right-to-left)"
msgstr "直排右翻（右至左）"

msgid "Horizontal (left-to-right)"
msgstr "橫排左翻（左至右）"

msgid "Start Capture (&S)"
msgstr "開始擷取 (&S)"

msgid "Cancel (&C)"
msgstr "取消 (&C)"

msgid "Kindlead - Structured capture from Kindle book (&K)..."
msgstr "Kindlead - Kindle 電子書結構化擷取 (&K)..."

msgid "Automatically convert Kindle for PC book into accessible HTML"
msgstr "將 Kindle for PC 的書籍自動轉換為完全無障礙的 HTML 文件"

msgid "Capture is currently in progress. Do you want to abort?"
msgstr "目前擷取處理正在進行中。是否確定要中止？"

msgid "Kindlead - Running"
msgstr "Kindlead - 執行中"

msgid ""
"Gemini API key is not configured.\n"
"Please go to NVDA Menu -> Preferences -> Settings -> Kindlead to enter your API key."
msgstr ""
"尚未設定 Gemini API 金鑰。\n"
"請前往 NVDA 功能表 -> 偏好設定 -> 設定 -> Kindlead 輸入您的 API 金鑰。"

msgid "Kindlead - API Key Required"
msgstr "Kindlead - 需要 API 金鑰"

msgid "Kindlead: Capture aborted."
msgstr "Kindlead: 已中止擷取。"

msgid "Kindlead: Starting capture. Bringing Kindle to front..."
msgstr "Kindlead: 開始擷取。正在將 Kindle 移至最前景..."

msgid "Kindlead: engine.py not found."
msgstr "Kindlead: 未找到 engine.py。"

msgid "Kindlead: Successfully captured '{title}' ({pages} pages) in {total_time}s!"
msgstr "Kindlead: 『{title}』全 {pages} 頁結構化擷取完成！（耗時: {total_time} 秒）"

msgid "Kindlead: Capture completed. Opening HTML on Desktop."
msgstr "Kindlead: 擷取已完成。正在桌面開啟產生的 HTML 文件。"

msgid ""
"Kindlead: An error occurred during capture.\n"
"{err_msg}"
msgstr ""
"Kindlead: 擷取過程中發生錯誤。\n"
"{err_msg}"

msgid "Kindlead: Unexpected error: {e}"
msgstr "Kindlead: 發生未預期的錯誤: {e}"
